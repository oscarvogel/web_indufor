<section id="inicio" class="relative min-h-screen flex items-center justify-center">
    <video autoplay muted loop class="absolute z-0 w-full h-full object-cover">
        <source src="{{hero.video}}" type="video/mp4">
        <source src="{{hero.video}}" type="video/webm">
        Tu navegador no soporta videos HTML5
    </video>
    <div class="absolute inset-0 bg-[#d4eac7] opacity-50 z-10"></div> 
    <div class="container mx-auto px-6 relative z-20 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-8 text-white drop-shadow-lg">
            {{hero.titulo}}
        </h1>
        <p class="text-lg md:text-xl mb-6 leading-relaxed text-white drop-shadow-md">
            {{hero.descripcion}}
        </p>
        <a href="{{hero.cta.link}}" class="bg-[#cc6333] text-white px-8 py-4 rounded-full text-lg hover:bg-[#c27b18] transition-transform transform hover:scale-105">
            {{hero.cta.texto}}
        </a>
        <p class="text-lg md:text-xl mt-4 leading-relaxed text-white drop-shadow-md">
            Calidad, confianza y compromiso garantizados.
        </p>
    </div>
</section>