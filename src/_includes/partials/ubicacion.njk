<!-- src/_includes/ubicacion.njk -->
<section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Columna izquierda - Información -->
        <div class="space-y-6">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900">
            Ubicación
          </h2>
          
          <p class="text-xl text-gray-600 leading-relaxed">
            Nuestras oficinas centrales están ubicadas en el corazón de la zona forestal, estratégicamente situadas para atender todas sus necesidades.
          </p>
  
          <!-- Horarios -->
          <div class="space-y-4">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 p-3 bg-emerald-50 rounded-lg">
                <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gray-900 mb-1">Horario de atención</h3>
                <p class="text-gray-600">Lunes a Viernes: 8:00 - 18:00</p>
              </div>
            </div>
  
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 p-3 bg-emerald-50 rounded-lg">
                <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gray-900 mb-1">Dirección</h3>
                <p class="text-gray-600">{{datos_empresa.direccion}}</p>
                <p class="text-gray-600 mt-2">
                    <a href="tel:{{datos_empresa.telefono}}" class="hover:text-emerald-600 transition-colors">
                      {{datos_empresa.telefono}}
                    </a>
                  </p>
              </div>
            </div>
          </div>
        </div>
  
        <!-- Columna derecha - Mapa -->
        <div class="h-[400px] lg:h-[500px] rounded-xl overflow-hidden shadow-lg">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4223.548791881235!2d-54.9708327238132!3d-26.821597089404314!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94f827e4fb9305e9%3A0xbc8e1b244b417f82!2sIndufor%20SRL!5e1!3m2!1ses!2sar!4v1738421058438!5m2!1ses!2sar" width="800" height="600" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>